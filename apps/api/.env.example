# ==============================================================================
# @app/api - Variables de Entorno (LLM, Base de Datos, Visión y Voz)
# ==============================================================================

# ── Base de Datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ai_uml

# ── Opción 1: Modelo Local en AWS EC2 (Ollama / vLLM) ──────────────────────────
# Si levantás Ollama en tu instancia AWS EC2 (CPU o GPU):
# OPENAI_BASE_URL=http://<IP_EC2_O_HOSTNAME>:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen2.5-coder:7b
# Nota: Para instancias pequeñas sin GPU (t4g.small / c6i.large), usar modelos ligeros:
# LLM_MODEL=qwen2.5-coder:3b o llama3.2:3b

# ── Opción 2: Proveedor en la Nube (Groq / OpenAI) ─────────────────────────────
# OPENAI_API_KEY=tu_api_key_aqui
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# ── Transcripción de Audio / Voz (Whisper) ────────────────────────────────────
# WHISPER_MODEL=whisper-large-v3-turbo
